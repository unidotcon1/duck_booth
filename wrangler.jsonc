{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-booth",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Static frontend. The Worker runs FIRST only for API + share routes;
  // everything else is served straight from the asset store (free, cached).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/p/*"]
  },

  // Regenerates public/backgrounds/manifest.json and public/stickers/manifest.json from the files in those folders.
  "build": { "command": "node scripts/build-backgrounds.mjs && node scripts/build-stickers.mjs" },

  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "photo-booth-photos" }
  ],

  // Per-IP upload throttle (Workers Rate Limiting binding).
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }
  ],

  "vars": {
    "MAX_UPLOAD_BYTES": "5242880",
    "PHOTO_TTL_DAYS": "30"
  },

  // Secret (NOT stored here):  npx wrangler secret put KIOSK_TOKEN
  "observability": { "enabled": true }
}
